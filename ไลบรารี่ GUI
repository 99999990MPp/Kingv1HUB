-- ============================================================
-- ================== CONSTRUCTOR =============================
-- ============================================================
function KingV1Hub.new(config)
    config = config or {}
    
    local self = setmetatable({}, KingV1Hub)
    
    self.Title = config.Title or "KINGV1 HUB"
    self.Subtitle = config.Subtitle or "v3.0"
    self.Theme = config.Theme or KingV1Hub.DefaultTheme
    self.MainSize = config.MainSize or UDim2.new(0, 620, 0, 460)
    self.MinSize = config.MinSize or UDim2.new(0, 620, 0, 44)
    
    self.Visible = true
    self.Minimized = false
    self.TabPages = {}
    self.ActiveTab = nil
    self.Connections = {}
    self.dragging = false
    self.dragStart = nil
    self.startPos = nil
    
    self:_CreateGui()
    
    return self
end

