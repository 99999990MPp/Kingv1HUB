function KingV1Hub:CreateTab(name, icon)
    local btn = Instance.new("TextButton")
    btn.Text = (icon and (icon .. "  ") or "") .. name
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = self.Theme.MainBG
    btn.TextColor3 = self.Theme.SubText
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 11
    btn.BorderSizePixel = 0
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.ZIndex = 2
    btn.Parent = self.TabBar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 7)
    local BtnPad = Instance.new("UIPadding", btn)
    BtnPad.PaddingLeft = UDim.new(0, 8)
    
    local page = Instance.new("ScrollingFrame")
    page.Name = "Page_" .. name
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.Visible = false
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = self.Theme.Accent
    page.ScrollingDirection = Enum.ScrollingDirection.Y
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Parent = self.PanelContainer
    
    local pageList = Instance.new("UIListLayout", page)
    pageList.Padding = UDim.new(0, 6)
    pageList.HorizontalAlignment = Enum.HorizontalAlignment.Center
    pageList.SortOrder = Enum.SortOrder.LayoutOrder
    local pagePad = Instance.new("UIPadding", page)
    pagePad.PaddingTop = UDim.new(0, 8)
    pagePad.PaddingBottom = UDim.new(0, 12)
    pagePad.PaddingLeft = UDim.new(0, 8)
    pagePad.PaddingRight = UDim.new(0, 8)
    
    self.TabPages[name] = { Button = btn, Page = page }
    
    table.insert(self.Connections, btn.MouseButton1Click:Connect(function()
        self:_SelectTab(name)
    end))
    
    return page
end

function KingV1Hub:_SelectTab(name)
    for tabName, t in pairs(self.TabPages) do
        t.Button.BackgroundColor3 = self.Theme.MainBG
        t.Button.TextColor3 = self.Theme.SubText
        t.Page.Visible = false
    end
    
    local tab = self.TabPages[name]
    if tab then
        tab.Button.BackgroundColor3 = self.Theme.TopBar
        tab.Button.TextColor3 = self.Theme.Accent
        tab.Page.Visible = true
        self.ActiveTab = name
        tab.Page.Position = UDim2.new(0.04, 0, 0, 0)
        tab.Page:TweenPosition(UDim2.new(0, 0, 0, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.18, true)
    end
end

