-- ============================================================
-- ================== WINDOW CONTROLS =========================
-- ============================================================
function KingV1Hub:_SetupWindowControls()
    -- Close Button
    table.insert(self.Connections, self.CloseBtn.MouseButton1Click:Connect(function()
        self:Shutdown()
    end))
    
    -- Minimize Button
    table.insert(self.Connections, self.MinBtn.MouseButton1Click:Connect(function()
        self.Minimized = not self.Minimized
        local sz = self.Minimized and self.MinSize or self.MainSize
        TweenService:Create(self.MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = sz }):Play()
        self.MinBtn.Text = self.Minimized and "+" or "−"
    end))
    
    -- Drag Functionality
    table.insert(self.Connections, self.TitleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            self.dragging = true
            self.dragStart = input.Position
            self.startPos = self.MainFrame.Position
        end
    end))
    
    table.insert(self.Connections, UserInputService.InputChanged:Connect(function(input)
        if self.dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - self.dragStart
            local sp = self.startPos
            self.MainFrame.Position = UDim2.new(sp.X.Scale, sp.X.Offset + delta.X, sp.Y.Scale, sp.Y.Offset + delta.Y)
        end
    end))
    
    table.insert(self.Connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            self.dragging = false
        end
    end))
    
    -- Toggle Visibility with INSERT key
    table.insert(self.Connections, UserInputService.InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == Enum.KeyCode.Insert then
            self.Visible = not self.Visible
            if self.Visible then
                self.MainFrame.Visible = true
                TweenService:Create(self.MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    BackgroundTransparency = 0,
                    Size = self.Minimized and self.MinSize or self.MainSize
                }):Play()
            else
                TweenService:Create(self.MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 }):Play()
                task.delay(0.22, function()
                    if self.MainFrame and self.MainFrame.Parent then
                        self.MainFrame.Visible = false
                    end
                end)
            end
        end
    end))
end

-- ============================================================
-- ================== ANIMATIONS ==============================
-- ============================================================
function KingV1Hub:_PlayOpenAnimation()
    self.MainFrame.Size = UDim2.new(0, 620, 0, 0)
    self.MainFrame.BackgroundTransparency = 1
    self.MainFrame.Visible = true
    task.wait(0.1)
    TweenService:Create(self.MainFrame, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = self.MainSize,
        BackgroundTransparency = 0
    }):Play()
end

-- ============================================================
-- ================== PUBLIC METHODS ==========================
-- ============================================================

function KingV1Hub:SelectTab(name)
    self:_SelectTab(name)
end

function KingV1Hub:GetActiveTab()
    return self.ActiveTab
end

function KingV1Hub:Shutdown()
    if self.ScreenGui and self.ScreenGui.Parent then
        self.ScreenGui:Destroy()
    end
    for _, conn in ipairs(self.Connections) do
        if conn then pcall(function() conn:Disconnect() end) end
    end
    print("[KINGV1 HUB] GUI Shutdown Complete")
end

function KingV1Hub:SetTheme(newTheme)
    self.Theme = setmetatable(newTheme, { __index = KingV1Hub.DefaultTheme })
end

function KingV1Hub:GetMainFrame()
    return self.MainFrame
end

function KingV1Hub:SetVisible(visible)
    self.Visible = visible
    self.MainFrame.Visible = visible
end

return KingV1Hub
